# True Sight Backend Configuration
# Copy this file to .env and fill in the values

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Database Paths
DATA_DIR=../data
DATABASE_PATH=../data/database/truesight.db
MATCHES_DIR=backend/data/matches
REPLAYS_DIR=../data/replays

# Parser Configuration
# Options: clarity (recommended), manta
PARSER_TYPE=clarity
CLARITY_JAR_PATH=../parsers/clarity/build/libs/clarity-parser.jar
JAVA_PATH=java

# External APIs (Optional)
OPENDOTA_API_KEY=
STRATZ_API_KEY=

# Performance Tuning
MAX_PARSE_WORKERS=2
CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=../data/logs/backend.log
